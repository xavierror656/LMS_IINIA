# Local development only. Change passwords before sharing an environment.
POSTGRES_PASSWORD=local-development-only
SEED_STUDENT_PASSWORD=change-this-student-password
SEED_TEACHER_PASSWORD=change-this-teacher-password
APP_ORIGIN=http://localhost:4321
APP_ENV=development
# Rate limits per 60 s window. Authenticated traffic counts per user, so a whole
# classroom behind one address does not share a budget; unauthenticated traffic
# counts per client address.
RATE_LIMIT_USER=600
RATE_LIMIT_IP=180
# Only these addresses or CIDR ranges may set X-Forwarded-For. Compose keeps the
# API on a private network behind the bundled proxy; production must narrow this
# to the real ingress range. Empty ignores the header entirely.
TRUSTED_PROXIES=172.16.0.0/12

---
import Layout from "../../../layouts/Layout.astro";
import ServiceError from "../../../components/astro/ServiceError.astro";
import AttachmentList from "../../../components/astro/AttachmentList.astro";
import RubricView from "../../../components/astro/RubricView.astro";
import { api,type Submission } from "../../../lib/api";
import type { components } from "../../../lib/generated/api";
const id=encodeURIComponent(Astro.params.lessonId??"");
const requested=Astro.url.searchParams.get("submissionId");
const cookie=Astro.request.headers.get("cookie")??"";
let error=Astro.locals.apiError;
let items:components['schemas']['SubmissionHistoryItem'][]=[];
let submission:Submission|null=null;
if(!error)try{
  items=(await api<components['schemas']['SubmissionHistory']>(`/lessons/${id}/submission/history`,{},cookie)).items;
  if(requested)submission=(await api<{submission:Submission|null}>(`/lessons/${id}/submission?submissionId=${encodeURIComponent(requested)}`,{},cookie)).submission;
}catch(e){error=e instanceof Error?e.message:"No se pudieron cargar tus intentos.";}
---
<Layout title="Mis intentos">
  <a class="link link-primary font-medium min-h-11 inline-flex items-center mb-2" href={`/lessons/${id}`}>← Volver al intento actual</a>
  <h1>Mis intentos</h1>
  {error ? <ServiceError message={error}/> : <>
    <p>El historial conserva tus trabajos. Solo puedes editar el borrador del intento actual desde la tarea.</p>
    <nav class="flex flex-wrap items-center gap-3" aria-label="Historial de intentos">{items.map(item=><a class="btn btn-outline btn-sm" href={`?submissionId=${item.id}`}>Intento {item.attempt} · {item.status==='draft'?'Borrador':'Enviado'}</a>)}</nav>
    {items.length===0 && <div class="card card-border bg-base-100 p-6 my-4"><p class="m-0">✏️ Aún no has guardado ningún intento. Abre la tarea para empezar tu borrador.</p></div>}
    {submission && <article class="card card-border bg-base-100 p-6 mt-6">
      <h2>Intento {submission.attempt}</h2><p>{submission.status==='draft'?'Borrador':'Enviado'}</p>
      <details class="collapse collapse-arrow border border-base-300 bg-base-100 rounded-box my-3"><summary class="collapse-title font-semibold">Instrucciones de este intento</summary><div class="collapse-content"><p class="reading-body">{submission.instructions}</p></div></details>
      <p class="reading-body">{submission.body}</p><AttachmentList files={submission.attachments}/>
      {submission.rubric && <RubricView rubric={submission.rubric} assessment={submission.grade?.assessment}/>}
      {submission.grade ? <><h3>Devolución publicada</h3><p>Calificación: {submission.grade.score} / 100</p><p class="reading-body">{submission.grade.feedback}</p></> : <p>No hay devolución publicada para este intento.</p>}
    </article>}
  </>}
</Layout>

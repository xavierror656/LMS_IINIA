---
import Layout from "../../layouts/Layout.astro";
import ServiceError from "../../components/astro/ServiceError.astro";
import CodePlayground from "../../components/react/CodePlayground";
import H5PPlayer from "../../components/react/H5PPlayer";
import Quiz from "../../components/astro/Quiz.astro";
import type {components} from "../../lib/generated/api";
let quiz:components["schemas"]["QuizOverview"]|undefined;
import Assignment from "../../components/astro/Assignment.astro";
import { api, type Lesson, type Submission, type Availability } from "../../lib/api";
import type { DemoPlugin } from "../../lib/demoPlugins";
let plugin: DemoPlugin | undefined;
let lesson: Lesson | undefined;
let submission: Submission | null = null;
let availability: Availability | undefined;
let instructionFiles: components["schemas"]["Attachment"][] = [];
let error = Astro.locals.apiError;
if (!error)
  try {
    lesson = await api<Lesson>(
      `/lessons/${encodeURIComponent(Astro.params.lessonId ?? "")}`,
      {},
      Astro.request.headers.get("cookie") ?? "",
    );
    if (lesson.type === "quiz") {const selected=Astro.url.searchParams.get("attemptId");quiz=await api<components["schemas"]["QuizOverview"]>(`/lessons/${lesson.id}/quiz${selected?`?attemptId=${encodeURIComponent(selected)}`:""}`,{},Astro.request.headers.get("cookie")??"");}
    if (lesson.type === "assignment") {
      availability = await api<Availability>(`/lessons/${lesson.id}/availability`, {}, Astro.request.headers.get("cookie") ?? "");
      submission = (await api<{submission: Submission | null}>(`/lessons/${lesson.id}/submission`, {}, Astro.request.headers.get("cookie") ?? "")).submission;
    }
    // Instruction files belong to the published version this student works against.
    instructionFiles = (await api<{ items: components["schemas"]["Attachment"][] }>(`/lessons/${lesson.id}/instructions`, {}, Astro.request.headers.get("cookie") ?? "")).items;
    if (
      import.meta.env.PUBLIC_DEMO_MODE === "true" &&
      (lesson.type === "code" || lesson.type === "h5p")
    ) {
      const result = await api<{ items: DemoPlugin[] }>(
        "/plugins",
        {},
        Astro.request.headers.get("cookie") ?? "",
      );
      plugin = result.items.find((p) => p.id === lesson?.type);
    }
  } catch (e) {
    error = e instanceof Error ? e.message : "No se pudo abrir la lección.";
  }
---

<Layout title={lesson?.title ?? "Lección"}>
  {error ? (
    <ServiceError message={error} />
  ) : (
    lesson && (
      <>
        <a class="crumb" href="/courses">
          ← Mis aventuras
        </a>
        <span class="eyebrow">Un nuevo descubrimiento</span>
        <h1>{lesson.title}</h1>
        <p>{lesson.description}</p>
        {plugin && (
          <aside class="plugin-intro">
            <h2>{plugin.title}</h2>
            <p>{plugin.instructions}</p>
          </aside>
        )}
        {lesson.type === "reading" ? (
          <article class="panel reading">
            <span class="tag">Lee a tu ritmo</span>
            <div class="reading-body">{lesson.config.body}</div>
            <div style="margin-top:32px">
              <button
                id="complete-reading"
                data-lesson={lesson.id}
                disabled={lesson.status === "completed"}
              >
                {lesson.status === "completed"
                  ? "✓ Lectura completada"
                  : "¡Terminé de leer! ✦"}
              </button>
              <p
                id="completion-status"
                role="status"
                class="helper"
                style="margin-top:20px"
              >
                Completar esta lectura otorga 25 XP, 1 estrella y 2 gemas una
                sola vez.
              </p>
            </div>
          </article>
        ) : lesson.type === "quiz" ? (<Quiz lessonId={lesson.id} overview={quiz!} body={lesson.config.body??""}/>) : lesson.type === "assignment" ? (
          <Assignment lesson={lesson} submission={submission} availability={availability!} files={instructionFiles} />
        ) : lesson.type === "code" ? (
          <CodePlayground
            lessonId={lesson.id}
            language={lesson.config.language ?? "javascript"}
            starter={lesson.config.starter ?? ""}
            client:load
          />
        ) : (
          <H5PPlayer
            lessonId={lesson.id}
            activity={lesson.config.activity ?? "demo"}
            client:only="react"
          />
        )}
      </>
    )
  )}
</Layout>
<script>
  import { completeReading } from "../../store/progress";
  document.addEventListener("astro:page-load", () => {
    document
      .querySelector<HTMLButtonElement>("#complete-reading")
      ?.addEventListener("click", async (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        const status = document.querySelector("#completion-status")!;
        button.disabled = true;
        status.textContent = "Guardando tu descubrimiento…";
        try {
          await completeReading(Number(button.dataset.lesson));
          button.textContent = "✓ Lectura completada";
          status.textContent = "¡Un paso más! Tu progreso está guardado.";
        } catch (e) {
          button.disabled = false;
          status.textContent =
            e instanceof Error
              ? e.message
              : "No se pudo guardar. Vuelve a intentarlo.";
        }
      });
  });
</script>

---
import Icon from "../components/astro/Icon.astro";
import Layout from "../layouts/Layout.astro";
import { brand } from "../config/brand";
export const prerender = true;
---

<Layout title="Aprender es una aventura">
  <section
    class="hero bg-lilac border border-lilac-line rounded-hero mb-9 overflow-hidden min-h-[unset]"
  >
    <div
      class="hero-content flex-col md:flex-row items-start md:items-center gap-8 p-8 md:p-12 max-w-none"
    >
      <div class="max-w-lg">
        <span class="badge badge-primary badge-soft mb-4">
          Un universo por descubrir
        </span>
        <h1>{brand.welcome}</h1>
        <p>
          {brand.description} Prueba una idea, encuentra una historia y celebra
          cada pequeño paso.
        </p>
        <a class="btn btn-primary min-h-12" href="/courses">
          Explorar mis aventuras <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="orbit"></div>
        <div class="planet"><Icon name="rocket" size={100}/></div>
        <span class="sticker top">✦ ¡Tú puedes crear!</span>
        <span class="sticker bottom">Un paso a la vez ✦</span>
      </div>
    </div>
  </section>
  <div class="flex items-end justify-between my-8 mb-5">
    <div>
      <span class="badge badge-primary badge-soft mb-3">
        Aprender a tu manera
      </span>
      <h2>Hay más de un camino para crecer</h2>
    </div>
  </div>
  <section
    class="grid grid-cols-1 md:grid-cols-3 gap-6 my-8"
    aria-label="Formas de aprender"
  >
    <div class="card card-border bg-base-100 p-6">
      <span class="text-3xl mb-3 block" aria-hidden="true">
        <Icon name="book" size={36}/>
      </span>
      <h3>Imagina leyendo</h3>
      <p class="text-sm">Historias cortas y preguntas que despiertan grandes ideas.</p>
    </div>
    <div class="card card-border bg-base-100 p-6">
      <span class="text-3xl mb-3 block" aria-hidden="true">
        <Icon name="code" size={36}/>
      </span>
      <h3>Experimenta creando</h3>
      <p class="text-sm">Tu primer laboratorio para conocer el mundo del código.</p>
    </div>
    <div class="card card-border bg-base-100 p-6">
      <span class="text-3xl mb-3 block" aria-hidden="true">✦</span>
      <h3>Celebra tus pasos</h3>
      <p class="text-sm">Una mochila de logros que crece contigo, sin prisas.</p>
    </div>
  </section>
  <section class="card card-border bg-base-100 p-8">
    <h2>Aquí, volver a intentar está bien.</h2>
    <p>
      Sin carreras ni comparaciones. Tus vidas nunca te impiden seguir
      aprendiendo.
    </p>
    <a
      class="link link-primary font-medium min-h-11 inline-flex items-center"
      href="/login"
    >
      Ya tengo una cuenta →
    </a>
  </section>
</Layout>

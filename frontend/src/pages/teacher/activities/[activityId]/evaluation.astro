---
import Layout from "../../../../layouts/Layout.astro";
import ServiceError from "../../../../components/astro/ServiceError.astro";
import AcademicForm from "../../../../components/astro/AcademicForm.astro";
import RubricFields from "../../../../components/astro/RubricFields.astro";
import { api, type Activity, type GradeCategory } from "../../../../lib/api";
let error = Astro.locals.apiError;
let activity: Activity | undefined;
let categories: GradeCategory[] = [];
const id = encodeURIComponent(Astro.params.activityId ?? "");
const cookie = Astro.request.headers.get("cookie") ?? "";
if (!error) try {
  activity=await api<Activity>(`/teacher/activities/${id}`,{},cookie);
  if(activity.type!=="assignment") error="Solo las tareas pueden tener rúbrica y peso.";
  else if(activity.courseId) categories=(await api<{items: GradeCategory[]}>(`/teacher/courses/${activity.courseId}/grade-categories`,{},cookie)).items;
} catch(e){error=e instanceof Error?e.message:"No se pudo cargar la evaluación.";}
---
<Layout title="Rúbrica y peso">
  <nav class="breadcrumbs text-sm mb-3" aria-label="Ruta de navegación"><ul><li><a class="link link-primary min-h-11 inline-flex items-center" href={`/teacher/activities/${id}`}>← Volver a la actividad</a></li><li><span class="opacity-70">Rúbrica y peso</span></li></ul></nav>
  <h1>Rúbrica y peso</h1>
  {error ? <ServiceError message={error}/> : activity && <section class="panel">
    <h2>{activity.title}</h2>
    <p>Guarda la evaluación y vuelve a la actividad para publicar la versión completa. Las entregas anteriores conservan su propia rúbrica.</p>
    <AcademicForm kind="evaluation" path={`/teacher/activities/${id}/evaluation`} version={activity.version}>
      <RubricFields rubric={activity.rubric} weight={activity.weight} categories={categories} categoryId={activity.categoryId ?? null}/>
    </AcademicForm>
  </section>}
</Layout>

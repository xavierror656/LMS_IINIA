---
import Layout from '../../../../layouts/Layout.astro';import ServiceError from '../../../../components/astro/ServiceError.astro';import QuizComposer from '../../../../components/astro/QuizComposer.astro';import{api,type Activity}from'../../../../lib/api';import type{components}from'../../../../lib/generated/api';
const id=encodeURIComponent(Astro.params.activityId??'');const cookie=Astro.request.headers.get('cookie')??'';let error=Astro.locals.apiError;let activity:Activity|undefined;let options:components['schemas']['QuizQuestionOptions']|undefined;
if(!error)try{[activity,options]=await Promise.all([api<Activity>(`/teacher/activities/${id}`,{},cookie),api<components['schemas']['QuizQuestionOptions']>(`/teacher/activities/${id}/quiz-questions`,{},cookie)]);}catch(e){error=e instanceof Error?e.message:'No se pudo abrir la configuración.';}
---
<Layout title="Configurar cuestionario"><a class="crumb" href={`/teacher/activities/${id}`}>← Volver a la actividad</a><h1>Configurar cuestionario</h1>
 {error?<ServiceError message={error}/>:activity&&options&&<><h2>{activity.title}</h2><p><a class="crumb" href={`/teacher/courses/${options.courseId}/questions`}>Crear o editar preguntas en el banco</a></p><section class="panel"><QuizComposer activity={activity} options={options}/></section></>}
</Layout>

---
import Layout from '../../../../layouts/Layout.astro';import ServiceError from '../../../../components/astro/ServiceError.astro';import{api}from'../../../../lib/api';import type{components}from'../../../../lib/generated/api';
const id=encodeURIComponent(Astro.params.activityId??'');const page=Math.max(1,Number(Astro.url.searchParams.get('page'))||1);let error=Astro.locals.apiError;let result:components['schemas']['QuizResultList']|undefined;
if(!error)try{result=await api<components['schemas']['QuizResultList']>(`/teacher/activities/${id}/quiz-results?page=${page}`,{},Astro.request.headers.get('cookie')??'');}catch(e){error=e instanceof Error?e.message:'No se pudieron consultar los resultados.';}
---
<Layout title="Intentos del cuestionario"><nav class="breadcrumbs text-sm mb-3" aria-label="Ruta de navegación"><ul><li><a class="link link-primary min-h-11 inline-flex items-center" href={`/teacher/activities/${id}`}>← Volver a la actividad</a></li><li><span class="opacity-70">Intentos del cuestionario</span></li></ul></nav><h1>Intentos del cuestionario</h1><p>Solo aparecen intentos enviados de estudiantes vinculados e inscritos. El libro aplica la política publicada; estos son los resultados individuales.</p>
 {error?<ServiceError message={error}/>:result&&<><div class="grid gap-4 my-6 mb-10">{result.items.map(item=><article class="panel"><h2>{item.alias} · intento {item.attempt}</h2><p>{item.score} / 100</p><a class="btn btn-outline" href={`/teacher/quiz-attempts/${item.id}`}>Revisar intento {item.attempt} de {item.alias}</a></article>)}</div>{result.items.length===0&&<div class="card card-border bg-base-100 p-6 my-4"><p class="m-0">🧭 No hay intentos enviados en esta página. Cuando el alumnado envíe su cuestionario aparecerán aquí.</p></div>}<nav class="join my-4 flex flex-wrap" aria-label="Páginas de resultados">{page>1&&<a class="link link-primary min-h-11 inline-flex items-center join-item" href={`?page=${page-1}`}>← Anterior</a>}{result.items.length===20&&<a class="link link-primary min-h-11 inline-flex items-center join-item" href={`?page=${page+1}`}>Siguiente →</a>}</nav></>}
</Layout>

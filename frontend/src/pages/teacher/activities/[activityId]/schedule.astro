---
import Layout from "../../../../layouts/Layout.astro";
import ServiceError from "../../../../components/astro/ServiceError.astro";
import AcademicForm from "../../../../components/astro/AcademicForm.astro";
import { api, type Activity } from "../../../../lib/api";
let error=Astro.locals.apiError;
let activity:Activity|undefined;
const id=encodeURIComponent(Astro.params.activityId??"");
if(!error)try {activity=await api<Activity>(`/teacher/activities/${id}`,{},Astro.request.headers.get("cookie")??"");if(activity.type!=="assignment")error="El calendario de entrega solo aplica a tareas.";}catch(e){error=e instanceof Error?e.message:"No se pudo abrir el calendario.";}
const inputDate=(value:string|null)=>value?new Date(value).toISOString().slice(0,19):"";
---
<Layout title="Fechas de la tarea">
  <a class="crumb" href={`/teacher/activities/${id}`}>← Volver a la actividad</a>
  <h1>Fechas de la tarea</h1>
  {error ? <ServiceError message={error}/> : activity && <section class="panel">
    <h2>{activity.title}</h2>
    <p>Todas las fechas de este formulario están en UTC (tiempo universal), no en la hora local del dispositivo. Deja un campo vacío para quitar ese límite.</p>
    <p>Después del vencimiento se permiten entregas tardías hasta el cierre. Guarda el borrador y vuelve a la actividad para publicar el calendario.</p>
    <AcademicForm kind="schedule" path={`/teacher/activities/${id}/schedule`} version={activity.version}>
      <label for="opens-at">Apertura (UTC)</label><input id="opens-at" name="opensAt" type="datetime-local" step="1" value={inputDate(activity.opensAt)}/>
      <label for="due-at">Fecha de entrega (UTC)</label><input id="due-at" name="dueAt" type="datetime-local" step="1" value={inputDate(activity.dueAt)}/>
      <label for="closes-at">Cierre (UTC)</label><input id="closes-at" name="closesAt" type="datetime-local" step="1" value={inputDate(activity.closesAt)}/>
    </AcademicForm>
  </section>}
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import ServiceError from "../../components/astro/ServiceError.astro";
import { api, type CourseMap, type StudentGrades } from "../../lib/api";
let data: CourseMap | undefined;
let grades: StudentGrades | undefined;
let gradesError: string | undefined;
let error = Astro.locals.apiError;
const courseId = encodeURIComponent(Astro.params.courseId ?? "");
const cookie = Astro.request.headers.get("cookie") ?? "";
if (!error)
  try {
    data = await api<CourseMap>(`/courses/${courseId}`, {}, cookie);
  } catch (e) {
    error = e instanceof Error ? e.message : "No se pudo abrir el curso.";
  }
if (!error)
  try {
    grades = await api<StudentGrades>(`/me/courses/${courseId}/grades`, {}, cookie);
  } catch (e) {
    gradesError = e instanceof Error ? e.message : "No pudimos cargar tus notas.";
  }
const labels = {
  available: "Disponible",
  in_progress: "En progreso",
  completed: "Completado",
};
const types = { reading: "Lectura", code: "Laboratorio", h5p: "Actividad", assignment: "Tarea", quiz: "Cuestionario" };
const grade = (hundredths: number | null) => (hundredths === null ? null : (hundredths / 100).toFixed(2));
const hasPublished = grades?.courseTotalHundredths !== null && grades?.courseTotalHundredths !== undefined;
const moduleStats = (data?.modules ?? []).map((module) => {
  const lessons = data!.lessons.filter((lesson) => lesson.moduleId === module.id);
  const done = lessons.filter((lesson) => lesson.status === "completed").length;
  return {
    module,
    lessons,
    done,
    total: lessons.length,
    percent: lessons.length ? Math.round((done / lessons.length) * 100) : 0,
  };
});
---

<Layout title={data?.course.title ?? "Tu camino"}>
  {error ? (
    <ServiceError message={error} />
  ) : (
    data && (
      <>
        <a
          class="link link-primary font-medium min-h-11 inline-flex items-center mb-2"
          href="/courses"
        >
          ← Mis aventuras
        </a>
        <span class="badge badge-primary badge-soft mb-3 block">
          Tu camino de aprendizaje
        </span>
        <h1>{data.course.title}</h1>
        <p>{data.course.description}</p>
        <ul class="steps steps-horizontal w-full my-6" aria-label="Módulos del curso">
          {moduleStats.map(({ module, total, done }) => (
            <li
              class:list={["step", total > 0 && done === total && "step-primary"]}
              aria-label={`${module.title}: ${done} de ${total} lecciones completadas`}
            >
              {module.position}
            </li>
          ))}
        </ul>
        {moduleStats.map(({ module, done, total, percent }) => (
          <section class="mt-8">
            <div class="flex flex-wrap items-end justify-between gap-2">
              <h2 class="m-0">
                {module.position}. {module.title}
              </h2>
              <span class="text-sm opacity-70">
                {total === 0
                  ? "Sin lecciones"
                  : `${done} de ${total} lecciones completadas`}
              </span>
            </div>
            <progress
              class="progress progress-primary w-full max-w-md my-3"
              value={percent}
              max="100"
              aria-label={`Avance del módulo ${module.title}`}
            ></progress>
            <div class="flex flex-col gap-4 my-6">
              {data.lessons
                .filter((l) => l.moduleId === module.id)
                .map((lesson) => (
                  <a
                    class:list={[
                      "card card-border bg-base-100 p-5 flex flex-row items-center gap-5 hover:shadow-md transition-shadow",
                      lesson.status,
                    ]}
                    href={`/lessons/${lesson.id}`}
                  >
                    <span
                      class:list={[
                        "w-14 h-14 rounded-2xl flex items-center justify-center text-2xl font-bold shrink-0",
                        lesson.status === "completed"
                          ? "bg-success text-success-content"
                          : "bg-primary/10 text-primary",
                      ]}
                      aria-hidden="true"
                    >
                      {lesson.status === "completed" ? "✓" : lesson.position}
                    </span>
                    <div class="min-w-0">
                      <h3 class="m-0 mb-1">{lesson.title}</h3>
                      <p class="text-sm m-0">
                        {types[lesson.type]} · {labels[lesson.status]}
                      </p>
                    </div>
                    <span class="arrow ml-auto" aria-hidden="true">
                      →
                    </span>
                  </a>
                ))}
            </div>
          </section>
        ))}
        <p class="text-sm text-muted">
          Puedes volver a cualquier lección. Aprender no gasta tus vidas.
        </p>
        <section class="card card-border bg-base-100 p-6 mt-8">
          <h2>Mis notas</h2>
          {gradesError ? (
            <p>{gradesError} Recarga la página para volver a intentarlo.</p>
          ) : grades && hasPublished ? (
            <>
              <p>
                <strong>Total del curso: {grade(grades.courseTotalHundredths)} / 100</strong>
              </p>
              <ul>
                {grades.categories.map((category) => (
                  <li>
                    <strong>{category.name}</strong> (peso {category.weight}):{" "}
                    {grade(category.totalHundredths) ?? "sin notas todavía"}
                    <ul>
                      {category.items.map((item) => (
                        <li>
                          {item.title}: {item.score === null ? "sin nota publicada" : `${item.score} / 100`}
                        </li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ul>
              <p class="text-sm text-muted">
                Solo aparecen las notas que tu docente publicó. Es un cálculo interno para acompañar tu
                aprendizaje, no un boletín oficial.
              </p>
            </>
          ) : (
            <p>Todavía no hay notas publicadas en este curso. Sigue avanzando: tu progreso se guarda.</p>
          )}
        </section>
      </>
    )
  )}
</Layout>

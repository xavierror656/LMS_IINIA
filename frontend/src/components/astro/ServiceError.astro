---
interface Props {
  message: string;
}
const { message } = Astro.props;
---

<section class="alert alert-error my-6" role="alert">
  <span class="text-xs font-bold uppercase tracking-widest">Hagamos una pausa</span>
  <h1>No pudimos cargar esta aventura</h1>
  <p>{message}</p>
  <a class="btn btn-primary" href={Astro.url.pathname} data-astro-reload>
    Volver a intentar
  </a>
</section>

DATABASE_URL=postgres://aulaquest:local-development-only@localhost:5432/aulaquest?sslmode=disable
APP_ORIGIN=http://localhost:4321
APP_ENV=development
LISTEN_ADDR=127.0.0.1:8080
SEED_STUDENT_PASSWORD=change-this-student-password
SEED_TEACHER_PASSWORD=change-this-teacher-password
# Rate limits per 60 s window: per session user when authenticated, per client
# address for unauthenticated traffic.
RATE_LIMIT_USER=600
RATE_LIMIT_IP=180
# Two-terminal development talks to the API directly, so no proxy is trusted and
# X-Forwarded-For is ignored. Set the ingress range only behind a real proxy.
TRUSTED_PROXIES=
